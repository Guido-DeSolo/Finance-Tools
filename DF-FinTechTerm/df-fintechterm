#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
env_file="${XDG_CONFIG_HOME:-$HOME/.config}/df-fintechterm/alpaca.env"
if [[ -r "$env_file" ]]; then set -a; source "$env_file"; set +a; fi
cmd="${1:-help}"; shift || true
run() { exec python3 -m "$1" "${@:2}"; }
case "$cmd" in
    help|-h|--help)
        cat <<'EOF'
df-fintechterm {account|orders|wealth|alpaca|classify|sentiment|news|insiders|llm|indicators|price|calc|services|actions|service|action|ledger|research|doctor}
Paper trading is the default. Live orders require --live and an explicit LIVE confirmation.
Run a command with --help for options; see README.md for the complete functionality list.
EOF
        ;;
    account) exec python3 -m df_fintech_term.orders account "$@" ;;
    orders) run df_fintech_term.orders "$@" ;;
    wealth) run df_fintech_term.personal "$@" ;;
    insiders)
        [[ "${1:-latest}" == latest || "${1:-latest}" == screener ]] || { echo 'usage: df-fintechterm insiders {latest|screener} [--refresh] [--json]' >&2; exit 2; }
        run df_fintech_term.openinsider "$@" ;;
    news)
        [[ "${1:-}" == curate ]] || { echo 'usage: df-fintechterm news curate SYMBOL [--output FILE]' >&2; exit 2; }
        shift; run df_fintech_term.curate "$@" ;;
    llm)
        [[ "${1:-}" == ask ]] || { echo 'usage: df-fintechterm llm ask PROMPT' >&2; exit 2; }
        shift; run df_fintech_term.llm_cli "$@" ;;
    indicators)
        case "${1:-}" in
            test) shift; exec python3 -m unittest discover -s "$ROOT/tests" -p 'test_indicators.py' -v ;;
            report) exec python3 "$ROOT/scripts/indicator_report.py" ;;
            example) exec python3 "$ROOT/scripts/indicator_example.py" ;;
            *) echo 'usage: df-fintechterm indicators {test|report|example}' >&2; exit 2 ;;
        esac ;;
    price)
        case "${1:-}" in
            bitcoin|silver) run df_fintech_term.tools.prices "$@" ;;
            *) echo 'usage: df-fintechterm price {bitcoin|silver}' >&2; exit 2 ;;
        esac ;;
    alpaca)
        case "${1:-}" in
            analysis) shift; run df_fintech_term.tools.live_analysis "$@" ;;
            stream)
                shift; run df_fintech_term.tools.stream_service "$@" ;;
            history-list) shift; exec "$ROOT/scripts/history-list" "$@" ;;
            *) run df_fintech_term.tools.alpaca_store "$@" ;;
        esac ;;
    classify) run df_fintech_term.tools.classify_symbols "$@" ;;
    sentiment) run df_fintech_term.tools.news_sentiment "$@" ;;
    calc) run df_fintech_term.tools.calculators "$@" ;;
    services|service|actions|action|catalog) exec "$ROOT/backend/df-fintechterm" "$cmd" "$@" ;;
    research) exec "$ROOT/backend/df-fintechterm" action daily-research "$@" ;;
    ledger) exec "$ROOT/backend/df-fintechterm" action ledger-audit "$@" ;;
    doctor)
        python3 -c 'import requests, websockets; import df_fintech_term' || { echo 'missing Python dependencies; install requirements.txt' >&2; exit 1; }
        "$ROOT/backend/df-fintechterm" catalog >/dev/null
        echo 'Finance CLI dependencies and command catalog are available.' ;;
    *) echo "unknown command: $cmd (try: df-fintechterm help)" >&2; exit 2 ;;
esac
