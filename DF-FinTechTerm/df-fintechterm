#!/usr/bin/env bash

set -o nounset
set -o pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
BACKEND="$ROOT/backend/df-fintechterm"
TOOLS_MODULE="df_fintech_term.tools"
cd -- "$ROOT"

usage() {
    cat <<'EOF'
DF-FinTechTerm — terminal, market data, research, and finance tools

Usage: df-fintechterm <command> [arguments]

Market analysis
  indicators test              Run the indicator test suite
  indicators report            Show the human-readable indicator report
  indicators example           Show deterministic example market data
  price bitcoin                Fetch the current BTC/USD price
  price silver                 Fetch the current silver price (requires key)
  tickrs [-- TICKRS_ARGS...]   Open tickrs with symbols containing stored data
  ticker [-- TICKER_ARGS...]   Open ticker with symbols containing stored data
  tickrs-industry [ARGS]       Select an industry, then open its symbols
  classify refresh [SYMBOL...] Tag stored stocks using SEC SIC industries
  classify populate-alpaca    Sync and classify every active Alpaca U.S. symbol
  classify list                View stored symbol classifications
  sentiment analyze ARTICLE_ID Analyze one stored article with local Ollama
  sentiment pending [ARGS]     Analyze stored articles without results
  sentiment list [SYMBOL]      View stored sentiment results
  alpaca sync-assets [ARGS]    Save Alpaca's stock and crypto symbol catalogs
  alpaca history [ARGS]        Download and save historical bars
  alpaca update-history        Increment every stored series through now minus 15m
  alpaca history-list FILE     Download full 1-minute history for new symbols
  alpaca status [ARGS]         Show local Alpaca database counts
  alpaca news [SYMBOL]         Show newest stored real-time news
  alpaca analysis [SYMBOL]     Show latest per-trade technical indicators
  alpaca timeframes            Show supported historical bar windows
  alpaca stream add SYMBOL --class stock|crypto [ARGS]
                                Add a symbol to the persisted watchlist
  alpaca stream remove SYMBOL --class stock|crypto [ARGS]
  alpaca stream list           View the persisted watchlist
  alpaca stream start|stop|restart|status
                                Control the single background daemon
  alpaca stream view [SYMBOL]  View books and trades live in the terminal

Background services and user actions
  services                     List scheduled/background data services
  service NAME [ARGS]          Run one service in the foreground
  actions                      List finite user-requested research actions
  action NAME [ARGS]           Run one research action

Calculators
  calc compound PRINCIPAL RATE YEARS [CONTRIBUTION]
                                Compound growth; RATE is annual percent
  calc gain COST VALUE          Gain/loss amount and percentage
  calc budget INCOME EXPENSE... Remaining money and savings rate
  calc allocate TOTAL WEIGHT... Split a total by weights or percentages

System
  doctor                        Check finance tools without network access
  help                          Show this help

Examples:
  df-fintechterm calc compound 1000 7 10 100
  df-fintechterm price bitcoin
  df-fintechterm alpaca sync-assets
  df-fintechterm alpaca history AAPL --class stock --timeframe 1Day

Financial calculations are informational, not financial advice.
EOF
}

die() { printf 'df-fintechterm: %s\n' "$*" >&2; exit 2; }

load_alpaca_env() {
    local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/df-fintechterm/alpaca.env"
    if [[ -r "$env_file" ]]; then
        set -o allexport
        # This is the user's private DF-FinTechTerm configuration file.
        # shellcheck source=/dev/null
        source "$env_file"
        set +o allexport
    fi
}

indicators() {
    case "${1:-}" in
        test) exec python3 -m unittest discover -s "$ROOT/tests" -p 'test_indicators.py' -v ;;
        report) exec python3 "$ROOT/scripts/indicator_report.py" ;;
        example) exec python3 "$ROOT/scripts/indicator_example.py" ;;
        *) die 'use: df-fintechterm indicators {test|report|example}' ;;
    esac
}

price() {
    case "${1:-}" in
        bitcoin) exec python3 -m "$TOOLS_MODULE.prices" bitcoin ;;
        silver) exec python3 -m "$TOOLS_MODULE.prices" silver ;;
        *) die 'use: df-fintechterm price {bitcoin|silver}' ;;
    esac
}

alpaca() {
    load_alpaca_env
    case "${1:-}" in
        sync-assets|history|update-history|status|timeframes|news)
            exec python3 -m "$TOOLS_MODULE.alpaca_store" "$@"
            ;;
        analysis)
            shift
            exec python3 -m "$TOOLS_MODULE.live_analysis" "$@"
            ;;
        history-list)
            shift
            exec "$ROOT/scripts/history-list" "$@"
            ;;
        stream)
            shift
            exec python3 -m "$TOOLS_MODULE.stream_service" "$@"
            ;;
        *) die 'use: df-fintechterm alpaca {sync-assets|history|update-history|status|timeframes|news|analysis}' ;;
    esac
}

backend_command() {
    [[ -x "$BACKEND" ]] || die "DF-FinTechTerm backend not found: $BACKEND"
    exec "$BACKEND" "$@"
}

calc() {
    case "${1:-}" in
        compound|gain|budget|allocate) exec python3 -m "$TOOLS_MODULE.calculators" "$@" ;;
        *) die 'use: df-fintechterm calc {compound|gain|budget|allocate}' ;;
    esac
}

doctor() {
    local failures=0
    if command -v python3 >/dev/null 2>&1; then
        printf 'ok      Python 3: %s\n' "$(command -v python3)"
    else
        printf 'missing Python 3\n'
        failures=$((failures + 1))
    fi
    if python3 -m compileall -q "$ROOT/df_fintech_term" >/dev/null 2>&1; then
        printf 'ok      Finance source syntax\n'
    else
        printf 'failed  Finance source syntax\n'
        failures=$((failures + 1))
    fi
    if python3 -c 'import websockets' >/dev/null 2>&1; then
        printf 'ok      Alpaca stream WebSocket dependency\n'
    else
        printf 'failed  Alpaca stream WebSocket dependency\n'
        failures=$((failures + 1))
    fi
    if python3 -m "$TOOLS_MODULE.alpaca_store" status >/dev/null 2>&1; then
        printf 'ok      Alpaca SQLite schema\n'
    else
        printf 'failed  Alpaca SQLite schema\n'
        failures=$((failures + 1))
    fi
    if python3 -m unittest discover -s "$ROOT/tests" -p 'test_indicators.py' >/dev/null 2>&1; then
        printf 'ok      Indicator test suite\n'
    else
        printf 'failed  Indicator test suite\n'
        failures=$((failures + 1))
    fi
    printf 'info    Bitcoin pricing needs internet access\n'
    if [[ -n "${METALPRICE_API_KEY:-}" ]]; then
        printf 'ok      METALPRICE_API_KEY is configured\n'
    else
        printf 'optional METALPRICE_API_KEY is not configured\n'
    fi
    printf '\nDoctor found %d issue(s).\n' "$failures"
    (( failures == 0 ))
}

command="${1:-help}"; shift || true
case "$command" in
    help|-h|--help) usage ;;
    indicators) indicators "$@" ;;
    price) price "$@" ;;
    tickrs) exec "$ROOT/scripts/tickrs-db" "$@" ;;
    ticker) exec "$ROOT/scripts/ticker-db" "$@" ;;
    tickrs-industry) exec python3 -m "$TOOLS_MODULE.tickrs_industry" "$@" ;;
    classify) exec python3 -m "$TOOLS_MODULE.classify_symbols" "$@" ;;
    sentiment) exec python3 -m "$TOOLS_MODULE.news_sentiment" "$@" ;;
    alpaca) alpaca "$@" ;;
    services|actions|catalog) backend_command "$command" "$@" ;;
    service|action) backend_command "$command" "$@" ;;
    calc) calc "$@" ;;
    doctor) doctor ;;
    *) die "unknown command: $command (try: df-fintechterm help)" ;;
esac
