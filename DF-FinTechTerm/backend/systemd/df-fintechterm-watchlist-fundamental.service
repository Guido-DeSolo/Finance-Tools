[Unit]
Description=Publish DF-FinTechTerm daily watchlist fundamental research
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/projects/Finance-Tools/DF-FinTechTerm/backend
Environment=DF_FINTECHTERM_MODE=backtest
EnvironmentFile=-%h/.config/df-fintechterm/df-fintechterm.env
ExecStart=%h/Documents/projects/Finance-Tools/DF-FinTechTerm/backend/df-fintechterm action watchlist-fundamental
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=-%h/.local/share/df-fintechterm/market-data
ReadOnlyPaths=-/mnt/archive/services/finance/market-data
ReadWritePaths=-%h/.local/share/df-fintechterm/research
ReadWritePaths=-/mnt/archive/services/finance/app-data/research
