[Unit]
Description=DF-FinTechTerm Alpaca watchlist market-data daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/df-fintechterm/alpaca.env
WorkingDirectory=@WORKING_DIRECTORY@
Environment=PYTHONPATH=@PYTHONPATH@
ExecStart="@PYTHON@" -m df_fintech_term.tools.live_stream --db "@DATABASE@"
Restart=always
RestartSec=5
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
