[Unit]
Description=Plutus background service: %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Finance-Tools/services/plutus
Environment=PLUTUS_MODE=backtest
EnvironmentFile=-%h/.config/plutus/plutus.env
ExecStart=%h/Finance-Tools/services/plutus/plutus service %i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/Finance-Tools/services/plutus

[Install]
WantedBy=default.target
