# Credentials and local environment configuration
.env
.env.*
*.key
*.keys
private/

# Databases and mutable database sidecars
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
data/
# DF-FinTechTerm uses this directory name for Python ingestion source, not stored data.
!DF-FinTechTerm/backend/data/
DF-FinTechTerm/backend/data/*
!DF-FinTechTerm/backend/data/*.py
!DF-FinTechTerm/backend/data/*.sql

# Python/runtime artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
venv/
build/
dist/
*.egg-info/

# Editor and OS files
.DS_Store
*.swp

# Project notes live as NOTE objects in the KiP-Proctor Obsidian vault.
/notes/
