# Credentials and local environment configuration
.env
.env.*
*.key
*.keys
private/

# Databases and mutable database sidecars
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
data/
# Plutus uses this directory name for Python ingestion source, not stored data.
!services/plutus/data/
services/plutus/data/*
!services/plutus/data/*.py
!services/plutus/data/*.sql

# Python/runtime artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
venv/
build/
dist/
*.egg-info/

# Editor and OS files
.DS_Store
*.swp
