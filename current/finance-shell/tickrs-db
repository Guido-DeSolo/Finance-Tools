#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
database="$SCRIPT_DIR/data/alpaca.sqlite3"
dry_run=false

usage() {
    cat <<'EOF'
Usage: tickrs-db [--db PATH] [--dry-run] [-- TICKRS_ARGS...]

Launch tickrs with every unique symbol that has historical or live market data
in the Finance Shell SQLite database. Extra arguments after -- are forwarded
to tickrs.
EOF
}

while (($#)); do
    case "$1" in
        --db)
            (($# >= 2)) || { echo 'tickrs-db: --db requires a path' >&2; exit 2; }
            database="$2"
            shift 2
            ;;
        --dry-run)
            dry_run=true
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        *)
            echo "tickrs-db: unknown option: $1 (put tickrs options after --)" >&2
            exit 2
            ;;
    esac
done

command -v sqlite3 >/dev/null 2>&1 || { echo 'tickrs-db: sqlite3 is not installed' >&2; exit 1; }
command -v tickrs >/dev/null 2>&1 || { echo 'tickrs-db: tickrs is not installed' >&2; exit 1; }
[[ -f "$database" ]] || { echo "tickrs-db: database not found: $database" >&2; exit 1; }

mapfile -t symbols < <(sqlite3 -noheader "$database" <<'SQL'
SELECT symbol
FROM (
    SELECT DISTINCT asset_class, symbol FROM bars
    UNION
    SELECT DISTINCT asset_class, symbol FROM live_trades
    UNION
    SELECT DISTINCT asset_class, symbol FROM live_market_events
    UNION
    SELECT DISTINCT asset_class, symbol FROM live_orderbooks
)
WHERE symbol <> ''
GROUP BY symbol
ORDER BY symbol COLLATE NOCASE;
SQL
)

((${#symbols[@]})) || { echo 'tickrs-db: no symbols with stored market data' >&2; exit 1; }
symbols_csv="$(IFS=,; echo "${symbols[*]}")"

if [[ "$dry_run" == true ]]; then
    printf 'tickrs --symbols %q' "$symbols_csv"
    if (($#)); then
        printf ' %q' "$@"
    fi
    printf '\n'
    exit 0
fi

exec tickrs --symbols "$symbols_csv" "$@"
