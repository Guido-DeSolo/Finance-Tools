[Unit]
Description=DF-FinTechTerm daily incremental historical bar update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/finance-shell/alpaca.env
WorkingDirectory=%h/Finance-Tools/current/DF-FinTechTerm/finance-shell
ExecStart=%h/Finance-Tools/current/DF-FinTechTerm/finance-shell/fsh alpaca update-history
NoNewPrivileges=true
PrivateTmp=true
