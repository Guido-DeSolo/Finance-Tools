[Unit]
Description=Finance Shell Alpaca watchlist market-data daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/finance-shell/alpaca.env
WorkingDirectory=@WORKING_DIRECTORY@
ExecStart="@PYTHON@" "@STREAM_SCRIPT@" --db "@DATABASE@"
Restart=always
RestartSec=5
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
