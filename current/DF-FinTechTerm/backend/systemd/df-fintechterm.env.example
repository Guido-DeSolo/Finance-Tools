# Install as ~/.config/df-fintechterm/df-fintechterm.env with mode 0600.
# Never commit real bot tokens.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional if the live-data database is elsewhere.
# ALPACA_DATA_DB=/absolute/path/to/alpaca.sqlite3

# Daily watchlist research output (default shown).
# DF_RESEARCH_OUTPUT_DIR=%h/.local/share/df-fintechterm/research
